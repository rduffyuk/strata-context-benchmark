--- /dev/null
+++ b/include/strata/core/session_memory_admission.hpp
@@ -0,0 +1,25 @@
+#pragma once
+#include "strata/core/conversation_memory.hpp"
+namespace strata::core {
+// Reclassify only the engine's file mappings before rechecking the existing admission rule.
+// Advisory byte counts never count as available RAM. One bounded attempt per session operation.
+template<class Probe, class Cool>
+bool session_memory_admit(uint64_t need, uint64_t floor, bool enabled, bool& cooled,
+                          Probe probe, Cool cool) {
+    auto memory = probe();
+    auto admits = [&] {
+        return conversation_memory_admit(memory ? std::optional<uint64_t>(memory->available) : std::nullopt,
+                                         need, floor);
+    };
+    if (admits()) return true;
+    if (!enabled || cooled || !memory || memory->source != MemorySource::cgroup ||
+        need > UINT64_MAX - floor) return false;
+    cooled = true;
+    cool([&] {
+        memory = probe();
+        return !memory || memory->source != MemorySource::cgroup || admits();
+    });
+    memory = probe();
+    return memory && memory->source == MemorySource::cgroup && admits();
+}
+}
--- /dev/null
+++ b/include/strata/core/cold_file_span.hpp
@@ -0,0 +1,88 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <utility>
+#include <vector>
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <fstream>
+#include <thread>
+#if defined(__linux__)
+#include <sys/mman.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#endif
+namespace strata::core::detail {
+// Caller supplies an owned, read-only regular-file mmap, never an anonymous/pinned arena.
+// The mapping remains valid and its bytes do not change. Count is advice, not RAM freed.
+template<class Stop>
+uint64_t cold_file_span(const uint8_t* base, uint64_t bytes, Stop stop) {
+#if defined(__linux__) && defined(MADV_COLD)
+    const long page = sysconf(_SC_PAGESIZE);
+    const auto address = reinterpret_cast<uintptr_t>(base);
+    if (!base || !bytes || page <= 0 || address % static_cast<uintptr_t>(page) ||
+        bytes > std::numeric_limits<size_t>::max() ||
+        bytes > std::numeric_limits<uintptr_t>::max() - address) return 0;
+    uint64_t advised = 0;
+    while (advised < bytes && !stop()) {
+        const size_t n = static_cast<size_t>(std::min<uint64_t>(bytes - advised, 256ull << 20));
+        if (madvise(const_cast<uint8_t*>(base + advised), n, MADV_COLD) != 0) break;
+        advised += n;
+    }
+    return advised;
+#else
+    (void) base; (void) bytes; (void) stop;
+    return 0;
+#endif
+}
+template<class Stop, class Advise>
+uint64_t advise_model_mappings(const std::vector<std::pair<std::string,std::string>>& inputs,
+                              Stop stop, Advise advise) {
+#if defined(__linux__) && defined(MADV_COLD)
+    if (stop()) return 0;
+    using Identity = std::array<unsigned long long,3>;
+    std::vector<Identity> allowed;
+    for (const auto& input : inputs) {
+        struct stat st{};
+        if (::stat(input.second.c_str(), &st) != 0 || !S_ISREG(st.st_mode)) continue;
+        const Identity id{static_cast<unsigned long long>(major(st.st_dev)),
+                          static_cast<unsigned long long>(minor(st.st_dev)),
+                          static_cast<unsigned long long>(st.st_ino)};
+        if (std::find(allowed.begin(),allowed.end(),id)==allowed.end()) allowed.push_back(id);
+    }
+    if (allowed.empty()) return 0;
+    std::ifstream maps("/proc/self/maps");
+    uint64_t advised=0;
+    for (std::string line; !stop() && std::getline(maps,line);) {
+        unsigned long start=0,end=0;unsigned long long offset=0,inode=0;
+        unsigned int device_major=0,device_minor=0;char permissions[5]{};
+        if (std::sscanf(line.c_str(),"%lx-%lx %4s %llx %x:%x %llu",&start,&end,permissions,
+                        &offset,&device_major,&device_minor,&inode)!=7 || end<=start) continue;
+        if (permissions[0]!='r' || permissions[1]!='-' || permissions[2]!='-' ||
+            (permissions[3]!='p' && permissions[3]!='s') || inode==0) continue;
+        const Identity id{device_major,device_minor,inode};
+        if (std::find(allowed.begin(),allowed.end(),id)==allowed.end()) continue;
+        advised+=advise(reinterpret_cast<const uint8_t*>(start),static_cast<uint64_t>(end-start));
+    }
+    return advised;
+#else
+    (void) inputs; (void) stop; (void) advise;return 0;
+#endif
+}
+template<class Enough>
+uint64_t cool_model_file_cache(const std::vector<std::pair<std::string,std::string>>& inputs, Enough enough) {
+#if defined(__linux__) && defined(MADV_COLD)
+    const auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(2);
+    auto stop=[&]{return std::chrono::steady_clock::now()>=deadline || enough();};
+    const auto advised=advise_model_mappings(inputs,stop,[&](const uint8_t* base,uint64_t bytes){return cold_file_span(base,bytes,stop);});
+    while (advised && !stop()) std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    return advised;
+#else
+    (void) inputs;(void) enough;return 0;
+#endif
+}
+}
